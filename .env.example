# ---------------------------------------------------------------- agent mode
#
# Leave AGENT_API_KEY empty and the app runs the deterministic scripted driver:
# a complete journey with no model, no key and no network. That is also the demo
# fallback if a live provider starts throttling.
#
# Set a key and the model-backed agent takes over. Any OpenAI-compatible
# provider works — Gemini and Groq both have free tiers.

AGENT_PROVIDER=gemini              # gemini | groq | openai
AGENT_API_KEY=
AGENT_MODEL=gemini-2.5-flash       # groq: llama-3.3-70b-versatile

# Force the scripted driver even when a key is set. Useful for a demo that has
# to be repeatable, or to fall back instantly mid-presentation.
# AGENT_MODE=scripted

# Point at any other OpenAI-compatible endpoint.
# AGENT_BASE_URL=

# ----------------------------------------------------------- observability
#
# Off unless OTEL_BACKEND is set, and off means nothing is registered — no
# exporter, no flush loop, no behaviour change. The demo must never depend on a
# remote service being reachable.
#
# Traces carry OpenInference attributes, which is the only vocabulary both
# supported backends read, so switching between them is this variable and
# nothing else.

# OTEL_BACKEND=langfuse            # langfuse | phoenix | otlp | none

# Langfuse — hosted, nothing to run locally. Keys from Project Settings.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com     # or https://eu.cloud.langfuse.com

# Arize Phoenix — self-hosted:
#   docker run -p 6006:6006 arizephoenix/phoenix:latest
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_API_KEY=                                 # Phoenix Cloud only

# Any other OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=key=value,key2=value2

# OTEL_SERVICE_NAME=car-matchmaker-api

# The eval judge. Deliberately a *different* model from the one under test —
# llama-3.3-70b-versatile is not on Groq's structured-outputs list, and a judge
# grading its own family is a weak judge besides.
# EVAL_JUDGE_PROVIDER=groq
# EVAL_JUDGE_MODEL=openai/gpt-oss-120b
# EVAL_JUDGE_API_KEY=

# ------------------------------------------------------------- service wiring
# Compose sets these itself; only needed for local overrides.
# API_PORT=8080
# MCP_PORT=8081
# MCP_URL=http://localhost:8081/mcp
