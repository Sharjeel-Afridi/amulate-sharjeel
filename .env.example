# ---------------------------------------------------------------- agent mode
#
# Leave AGENT_API_KEY empty and the app runs the deterministic scripted driver:
# a complete journey with no model, no key and no network. That is also the demo
# fallback if a live provider starts throttling.
#
# Set a key and the model-backed agent takes over. Any OpenAI-compatible
# provider works — Gemini and Groq both have free tiers.

AGENT_PROVIDER=gemini              # gemini | groq | openai
AGENT_API_KEY=
AGENT_MODEL=gemini-2.5-flash       # groq: llama-3.3-70b-versatile

# Force the scripted driver even when a key is set. Useful for a demo that has
# to be repeatable, or to fall back instantly mid-presentation.
# AGENT_MODE=scripted

# Point at any other OpenAI-compatible endpoint.
# AGENT_BASE_URL=

# ------------------------------------------------------------- service wiring
# Compose sets these itself; only needed for local overrides.
# API_PORT=8080
# MCP_PORT=8081
# MCP_URL=http://localhost:8081/mcp
