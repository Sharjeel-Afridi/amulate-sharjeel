# Optional. Without a key the scripted driver serves a complete, deterministic
# journey — which is also the demo fallback if a live API is throttled.
AGENT_PROVIDER=gemini
AGENT_API_KEY=
AGENT_MODEL=gemini-2.5-flash

# Service wiring. Compose sets these itself; only needed for local dev overrides.
# API_PORT=8080
# MCP_PORT=8081
# MCP_URL=http://localhost:8081/mcp
